{
  "name": "kbc-fe",
  "version": "1.0.0",
  "description": "Simple Node server for KBC front-end assignments",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "sass public/blog-explorer/styles/main.scss public/blog-explorer/styles/main.css --no-source-map",
    "watch:css": "sass --watch public/blog-explorer/styles/main.scss public/blog-explorer/styles/main.css --no-source-map"
  },
  "keywords": [
    "kbc",
    "frontend",
    "server"
  ],
  "author": "Hesham Hassan",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
